{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dated public holiday calendar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "valid_from",
    "valid_through",
    "source",
    "holidays"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "format": "date"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_through": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "holidays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
